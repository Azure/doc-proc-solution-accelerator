{
  "services": [
    {
      "name": "azure_storage_01",
      "type": "azure_blob",
      "test_connection": true,
      "settings": {
        "account_name": "${AZURE_STORAGE_SERVICE_ACCOUNT_NAME}",
        "credential_type": "${AZURE_STORAGE_SERVICE_CREDENTIAL_TYPE}",
        "credential_key": "${AZURE_STORAGE_SERVICE_ACCOUNT_KEY}"
      }
    },
    {
      "name": "azure_ai_inference_service_01",
      "type": "azure_ai_inference",
      "test_connection": true,
      "settings": {
        "endpoint": "${AZURE_AI_INFERENCE_SERVICE_ENDPOINT}",
        "credential_type": "${AZURE_AI_INFERENCE_SERVICE_CREDENTIAL_TYPE}",
        "api_key": "${AZURE_AI_INFERENCE_SERVICE_API_KEY}"
      }
    }
  ],
  "steps": [
    {
      "id": "sample_step",
      "description": "Sample step for development",
      "type": "script",
      "module_name": "sample",
      "module_path": "./doc/proc/step/sample.py",
      "class_name": "SampleStep",
      "tags": ["sample"]
    },
    {
      "id": "pdf_to_png",
      "description": "Convert PDF pages to PNG images",
      "type": "script",
      "module_name": "pdf_to_png",
      "module_path": "./doc/proc/step/extract_pdf_to_png.py",
      "class_name": "PDFPagesToPNGStep",
      "tags": ["pdf", "png", "azure_blob"]
    },
    {
      "id": "pdf_page_png_to_markdown",
      "description": "Convert PDF page images to Markdown format using Azure AI Inference Service",
      "type": "script",
      "module_name": "pdf_page_png_to_markdown",
      "module_path": "./doc/proc/step/pdf_page_png_to_markdown.py",
      "class_name": "PDFPagePNGToMarkdownStep",
      "tags": ["transform", "extraction", "markdown", "azure_ai_inference"]
    }
  ],
  "pipelines": [
    {
      "name": "pipeline_1",
      "description": "A pipeline to extract, transform, and load documents from Azure Blob Storage to a database",
      "updated_at": "2023-10-01T12:00:00Z",
      "version": "1.0",
      "step_instances": [
        {
          "name": "samplp1",
          "step_id": "sample_step",
          "enabled": true,
          "settings": {
            "fail_pipeline_on_error": true,
            "retry_on_failure": true,
            "retries": 3,
            "timeout": 600,
            "key1": "value1",
            "key2": "value2"
          }
        },
        {
          "name": "pdf_to_png_1",
          "step_id": "pdf_to_png",
          "enabled": true,
          "settings": {
            "fail_pipeline_on_error": true,
            "retry_on_failure": false,
            "retries": 3,
            "timeout": 600,
            "png_output_folder": "./output/png",
            "num_pages": 10
          }
        },
        {
          "name": "pdf_page_png_to_markdown_1",
          "step_id": "pdf_page_png_to_markdown",
          "enabled": true,
          "settings": {
            "fail_pipeline_on_error": true,
            "retry_on_failure": false,
            "retries": 3,
            "timeout": 600,
            "ai_model_inference_service": "azure_ai_inference_service_01",
            "prompts": {
              "system": "You are an AI assistant that helps convert images of pages of a pdf document to markdown text. Only output valid markdown.",
              "user": "Extract the text from the following image into markdown and provide descriptions of images. Always format the markdown as follows to distinguish the text extracted from image descriptions:\n==Extracted-Text==\n{Insert extracted text as markdown here}\n\n==Image-Descriptions==\n{Insert image descriptions as markdown here}"
            },
            "max_completion_tokens": 4000,
            "temperature": 1.0,
            "top_p": 1.0,
            "frequency_penalty": 0.0,
            "presence_penalty": 0.0
          }
        }
      ],
      "execution_sequence": ["pdf_to_png_1", "pdf_page_png_to_markdown_1"],
      "settings": {
        "enabled": true,
        "retries": 2,
        "retry_delay": 60,
        "timeout": 300,
        "max_concurrent_runs": 5,
        "logging": {
          "enabled": true,
          "level": "INFO",
          "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
          "handlers": [
            {
              "type": "console",
              "level": "INFO"
            },
            {
              "type": "file",
              "level": "ERROR",
              "filename": "pipeline_errors.log"
            }
          ]
        }
      }
    }
  ]
}
